# SmartRoute Backend Environment Configuration Template
PORT=5000
NODE_ENV=development

# Database Configuration (Use MongoDB Atlas for production)
# Production Example: MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smartroute?retryWrites=true&w=majority
# Local Development:  MONGO_URI=mongodb://127.0.0.1:27017/smartroute
MONGO_URI=mongodb://127.0.0.1:27017/smartroute

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# CORS & Client Application URLs
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
SOCKET_CORS_ORIGIN=http://localhost:5173

# OpenStreetMap & OSRM Routing Providers
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org

# Email Service (Optional for development OTP testing)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password
